package com.example.ui.screens

import androidx.compose.foundation.BorderStroke
import androidx.compose.foundation.background
import androidx.compose.foundation.clickable
import androidx.compose.foundation.layout.*
import androidx.compose.foundation.lazy.grid.GridCells
import androidx.compose.foundation.lazy.grid.LazyVerticalGrid
import androidx.compose.foundation.lazy.grid.items
import androidx.compose.foundation.shape.CircleShape
import androidx.compose.foundation.shape.RoundedCornerShape
import androidx.compose.material.icons.Icons
import androidx.compose.material.icons.filled.*
import androidx.compose.material3.*
import androidx.compose.runtime.*
import androidx.compose.ui.Alignment
import androidx.compose.ui.Modifier
import androidx.compose.ui.draw.clip
import androidx.compose.ui.graphics.Color
import androidx.compose.ui.graphics.vector.ImageVector
import androidx.compose.ui.platform.testTag
import androidx.compose.ui.text.font.FontWeight
import androidx.compose.ui.unit.dp
import androidx.compose.ui.unit.sp
import com.example.ui.theme.BlackPrimary
import com.example.ui.theme.GoldPrimary
import com.example.ui.viewmodel.FinanceViewModel

data class CategoryDef(
    val id: String,
    val title: String,
    val subtitle: String,
    val icon: ImageVector,
    val countBadge: String = ""
)

@OptIn(ExperimentalMaterial3Api::class)
@Composable
fun MainCategoriesScreen(
    viewModel: FinanceViewModel,
    onNavigateBack: () -> Unit,
    onCategoryClick: (String) -> Unit,
    onAddNewCategory: () -> Unit,
    onLogout: () -> Unit,
    modifier: Modifier = Modifier
) {
    var currentTimeString by remember { mutableStateOf("") }
    var currentDateString by remember { mutableStateOf("") }
    var showSearchDialog by remember { mutableStateOf(false) }
    var searchQuery by remember { mutableStateOf("") }
    var showVoiceDialog by remember { mutableStateOf(false) }

    LaunchedEffect(Unit) {
        val timeFormat = java.text.SimpleDateFormat("hh:mm a", java.util.Locale("ar"))
        val dateFormat = java.text.SimpleDateFormat("d MMMM yyyy", java.util.Locale("ar"))
        while (true) {
            val now = java.util.Date()
            currentTimeString = timeFormat.format(now)
            currentDateString = dateFormat.format(now)
            kotlinx.coroutines.delay(1000L)
        }
    }

    val categories = remember {
        listOf(
            CategoryDef("personal_expenses", "المصروفات الشخصية", "متابعة المصاريف الخاصة", Icons.Default.Person, "نشط"),
            CategoryDef("home_expenses", "مصروفات المنزل", "مصاريف العائلة والمعيشة", Icons.Default.Home, "رئيسي"),
            CategoryDef("my_car", "سيارتي وتكاليفها", "وقود، صيانة، ترخيص", Icons.Default.DirectionsCar, "مركبات"),
            CategoryDef("education", "التعليم والدراسة", "رسوم ومستلزمات دراسية", Icons.Default.School, ""),
            CategoryDef("vendors_clients", "العملاء والموردون", "الحسابات والذمم المالية", Icons.Default.Work, "أعمال"),
            CategoryDef("income_certificates", "شهادات الدخل", "الأرباح والعوائد المالية", Icons.Default.AccountBalance, "دخل"),
            CategoryDef("reports", "التقارير التحليلية", "الرسوم البيانية والمؤشرات", Icons.Default.Analytics, "ذكاء"),
            CategoryDef("budgets", "الميزانية التشغيلية", "الخطط المالية والمخصصات", Icons.Default.PieChart, "ميزانية")
        )
    }

    Scaffold(
        modifier = modifier.fillMaxSize(),
        topBar = {
            Column(
                modifier = Modifier
                    .fillMaxWidth()
                    .background(MaterialTheme.colorScheme.background)
                    .padding(horizontal = 16.dp, vertical = 6.dp)
            ) {
                ExecutiveHeader(
                    timeString = currentTimeString,
                    dateString = currentDateString,
                    onSearchClick = { showSearchDialog = true },
                    onVoiceClick = { showVoiceDialog = true },
                    onSettingsClick = { },
                    onLogout = onLogout,
                    onHomeClick = onNavigateBack
                )

                Spacer(modifier = Modifier.height(6.dp))

                LiveFinancialTickerBar()

                if (showSearchDialog) {
                    SearchDialog(
                        query = searchQuery,
                        onQueryChange = { searchQuery = it },
                        onDismiss = { showSearchDialog = false }
                    )
                }

                if (showVoiceDialog) {
                    VoiceSearchDialog(onDismiss = { showVoiceDialog = false })
                }
            }
        },
        floatingActionButton = {
            FloatingActionButton(
                onClick = onAddNewCategory,
                containerColor = GoldPrimary,
                contentColor = BlackPrimary,
                modifier = Modifier.testTag("fab_add_category")
            ) {
                Icon(Icons.Default.Add, contentDescription = "إضافة قسم جديد")
            }
        }
    ) { innerPadding ->
        Column(
            modifier = Modifier
                .fillMaxSize()
                .padding(innerPadding)
                .padding(16.dp)
        ) {
            Row(
                modifier = Modifier.fillMaxWidth(),
                horizontalArrangement = Arrangement.SpaceBetween,
                verticalAlignment = Alignment.CenterVertically
            ) {
                Text(
                    text = "الأقسام والتكاليف التنفيذية",
                    style = MaterialTheme.typography.titleLarge,
                    fontWeight = FontWeight.Bold,
                    color = MaterialTheme.colorScheme.onBackground
                )
                TextButton(onClick = onNavigateBack) {
                    Icon(Icons.Default.ArrowBack, contentDescription = null, modifier = Modifier.size(16.dp))
                    Spacer(modifier = Modifier.width(4.dp))
                    Text("الرئيسية", color = GoldPrimary)
                }
            }

            Spacer(modifier = Modifier.height(12.dp))

            LazyVerticalGrid(
                columns = GridCells.Fixed(2),
                horizontalArrangement = Arrangement.spacedBy(12.dp),
                verticalArrangement = Arrangement.spacedBy(12.dp),
                modifier = Modifier
                    .fillMaxSize()
                    .testTag("categories_grid")
            ) {
                items(categories) { cat ->
                    Card(
                        onClick = { onCategoryClick(cat.id) },
                        colors = CardDefaults.cardColors(
                            containerColor = MaterialTheme.colorScheme.surface
                        ),
                        elevation = CardDefaults.cardElevation(defaultElevation = 2.dp),
                        shape = RoundedCornerShape(16.dp),
                        border = BorderStroke(1.dp, GoldPrimary.copy(alpha = 0.3f)),
                        modifier = Modifier
                            .fillMaxWidth()
                            .height(140.dp)
                            .testTag("category_card_${cat.id}")
                    ) {
                        Column(
                            modifier = Modifier
                                .fillMaxSize()
                                .padding(14.dp),
                            verticalArrangement = Arrangement.SpaceBetween
                        ) {
                            Row(
                                modifier = Modifier.fillMaxWidth(),
                                horizontalArrangement = Arrangement.SpaceBetween,
                                verticalAlignment = Alignment.CenterVertically
                            ) {
                                Box(
                                    modifier = Modifier
                                        .size(40.dp)
                                        .clip(CircleShape)
                                        .background(GoldPrimary.copy(alpha = 0.15f)),
                                    contentAlignment = Alignment.Center
                                ) {
                                    Icon(
                                        imageVector = cat.icon,
                                        contentDescription = cat.title,
                                        tint = GoldPrimary,
                                        modifier = Modifier.size(22.dp)
                                    )
                                }
                                if (cat.countBadge.isNotEmpty()) {
                                    Surface(
                                        shape = RoundedCornerShape(8.dp),
                                        color = GoldPrimary.copy(alpha = 0.2f)
                                    ) {
                                        Text(
                                            text = cat.countBadge,
                                            style = MaterialTheme.typography.labelSmall,
                                            color = GoldPrimary,
                                            modifier = Modifier.padding(horizontal = 6.dp, vertical = 2.dp)
                                        )
                                    }
                                }
                            }

                            Column {
                                Text(
                                    text = cat.title,
                                    style = MaterialTheme.typography.titleMedium,
                                    fontWeight = FontWeight.Bold,
                                    color = MaterialTheme.colorScheme.onSurface,
                                    maxLines = 1
                                )
                                Spacer(modifier = Modifier.height(2.dp))
                                Text(
                                    text = cat.subtitle,
                                    style = MaterialTheme.typography.bodySmall,
                                    color = MaterialTheme.colorScheme.onSurfaceVariant,
                                    maxLines = 1
                                )
                            }
                        }
                    }
                }
            }
        }
    }
}
